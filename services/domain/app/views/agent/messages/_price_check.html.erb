<%# pc = PriceCheck::Result. A plain-language price verdict comparing the asking
    price to Atlas's estimate and to nearby comps; model attributions live in the
    collapsible reasoning, not the headline. %>
<div class="agent-msg agent-msg--bot">
  <div class="agent-bubble">
    <p>
      This home is listed at <strong><%= number_to_currency(pc.asking, precision: 0) %></strong>.
      Atlas estimates its value at <strong><%= number_to_currency(pc.estimate, precision: 0) %></strong>
      (range <%= number_to_currency(pc.low, precision: 0) %>–<%= number_to_currency(pc.high, precision: 0) %>) —
      <% if pc.vs_estimate_word == "in line with" %>
        so the asking is right around my estimate.
      <% else %>
        so the asking is about <strong><%= pc.vs_estimate_pct %>% <%= pc.vs_estimate_word %></strong> my estimate.
      <% end %>
    </p>

    <% if pc.comp_median %>
      <p>
        The nearest recent sales run around <strong><%= number_to_currency(pc.comp_median, precision: 0) %></strong> (median),
        putting the asking <strong><%= pc.vs_comps_word %></strong> comparable sales.
      </p>
    <% end %>

    <p class="agent-verdict">
      <% badge = pc.verdict == "looks well-priced" ? "mk-badge--good" : (pc.verdict == "priced at a premium" ? "mk-badge--warn" : "mk-badge--good") %>
      <span class="mk-badge <%= badge %>"><%= pc.verdict %></span>
    </p>
  </div>

  <% val = local_assigns.fetch(:valuation, @valuation) %>
  <% if val.respond_to?(:as_of) && val.as_of.present? %>
    <p class="mk-meta">&#128197; Data as of <%= val.as_of.to_date.strftime("%b %-d, %Y") rescue val.as_of %> &middot; updated ~daily</p>
  <% end %>
  <% if val.respond_to?(:recent_activity) && val.recent_activity.present? %>
    <p class="mk-meta">&#128200; <%= val.recent_activity %></p>
  <% end %>
  <% comp_facts = val.respond_to?(:facts) ? Array(val.facts).select { |f| f.kind == "comp:active_listing" } : [] %>
  <% if comp_facts.any? %>
    <details class="mk-comps">
      <summary>Comparable active listings used (<%= comp_facts.size %>)</summary>
      <ul>
        <% comp_facts.each do |f| %><li><%= f.description %></li><% end %>
      </ul>
    </details>
  <% end %>
  <% if val.respond_to?(:low_confidence?) && val.low_confidence? %>
    <p class="mk-meta mk-meta--warn">&#9888; Limited data for this address &mdash; estimate shown at lower confidence.</p>
  <% end %>

  <details class="agent-reasoning">
    <summary>How Atlas reached this</summary>

    <ul class="agent-claims">
      <li>
        <span class="agent-claim-text">Asking price <%= number_to_currency(pc.asking, precision: 0) %></span>
        <span class="agent-cite">— this listing</span>
      </li>
      <li>
        <span class="agent-claim-text">Atlas estimate <%= number_to_currency(pc.estimate, precision: 0) %>
          (<%= number_to_currency(pc.low, precision: 0) %>–<%= number_to_currency(pc.high, precision: 0) %>)</span>
        <span class="agent-cite">— <%= source_label("valuation_run") %></span>
      </li>
      <% if pc.comps.any? %>
        <li>
          <span class="agent-claim-text">Nearby sales:
            <%= pc.comps.map { |c| number_to_currency(c.sale_price, precision: 0) }.to_sentence %></span>
          <span class="agent-cite">— <%= pc.comps.first.source_name %></span>
        </li>
      <% end %>
    </ul>

    <% drivers = pc.facts.sort_by { |f| -f.contribution.to_f.abs }.first(5) %>
    <% if drivers.any? %>
      <div class="agent-signals" style="flex-direction: column; gap: 4px;">
        <span class="mk-muted" style="font-weight:600;">What drives this estimate</span>
        <span class="mk-muted" style="font-size: 0.85em;">How much each feature of <em>this</em> home adds to or subtracts from the estimate:</span>
        <% drivers.each do |f| %>
          <% c = f.contribution.to_f %>
          <span class="agent-driver">
            <span class="agent-claim-text"><%= f.description %></span>
            <% if c.abs >= 1 %>
              <span class="mk-badge <%= c >= 0 ? "mk-badge--good" : "mk-badge--warn" %>">
                <%= c >= 0 ? "+" : "−" %><%= number_to_currency(c.abs, precision: 0) %>
              </span>
            <% end %>
          </span>
        <% end %>
      </div>
    <% end %>
    <p class="agent-caveat">Figures show how the automated model weighs each feature for this home; the comps above are real recorded sales. It's a data-driven estimate (the model is trained on sample data for this demo), not a formal appraisal.</p>
  </details>
</div>
