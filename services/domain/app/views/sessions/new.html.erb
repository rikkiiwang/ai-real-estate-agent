<% content_for :title, "Sign in — Atlas" %>

<div class="mk-auth">
  <h1>Sign in to Atlas</h1>
  <p class="mk-muted">Name and email only — no password. One sign-in gives you both a Buyer and a Seller workspace.</p>

  <%= form_with url: session_path, method: :post, class: "mk-auth-form" do |f| %>
    <div class="mk-field">
      <%= f.label :name %>
      <%= f.text_field :name, value: params[:name], autofocus: true, placeholder: "Jordan Rivera" %>
    </div>
    <div class="mk-field">
      <%= f.label :email %>
      <%= f.email_field :email, value: params[:email], placeholder: "you@example.com" %>
    </div>
    <%= f.submit "Continue", class: "mk-btn" %>
  <% end %>
</div>
