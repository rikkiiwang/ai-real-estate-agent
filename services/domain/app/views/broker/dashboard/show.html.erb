<% content_for :title, "Broker console — Atlas" %>

<div class="mk-results-head">
  <h1>Review dashboard</h1>
  <span class="mk-count">The human-in-the-loop: nothing is signed until a licensed broker approves it.</span>
</div>

<section id="time-to-offer" class="mk-card-section">
  <h2>Time to offer</h2>
  <table class="mk-table">
    <thead>
      <tr>
        <th>Side</th>
        <th>Offers recorded</th>
        <th>Average time to offer</th>
      </tr>
    </thead>
    <tbody>
      <% @time_to_offer.each do |side, stats| %>
        <tr class="time-to-offer" data-side="<%= side %>">
          <td><%= side.capitalize %></td>
          <td class="count"><%= stats[:count] %></td>
          <td class="average">
            <%= stats[:average_seconds] ? distance_of_time_in_words(stats[:average_seconds]) : "—" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section id="closing-deals" class="mk-card-section">
  <h2>Closing pipeline</h2>
  <% if @closing_deals.any? %>
    <% @closing_deals.each do |offer| %>
      <div class="mk-closing-deal" data-offer="<%= offer.id %>">
        <h3><%= offer.property&.address || "Deal #{offer.id}" %> · <%= offer.deal_id %></h3>
        <%= render "shared/closing_tracker", offer: offer %>
        <% if offer.closing_complete? %>
          <p class="mk-badge mk-badge--good">✅ Closed — funded.</p>
        <% else %>
          <%= button_to "Mark: #{offer.next_closing_milestone.humanize}",
                record_milestone_broker_offer_path(offer),
                params: { milestone: offer.next_closing_milestone }, class: "mk-btn" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="mk-muted">No signed deals in closing yet.</p>
  <% end %>
</section>

<section id="handoff-queue" class="mk-card-section">
  <h2>Handoff queue <span class="mk-badge mk-badge--warn"><%= @handoffs.size %></span></h2>
  <% if @handoffs.any? %>
    <table class="mk-table">
      <thead>
        <tr>
          <th>Lead</th>
          <th>Trigger</th>
          <th>Confidence</th>
          <th>Reason</th>
          <th>Recommended action</th>
        </tr>
      </thead>
      <tbody>
        <% @handoffs.each do |packet| %>
          <tr class="handoff">
            <td><%= packet.lead.address %> (<%= packet.lead.side %>)</td>
            <td><%= packet.trigger %></td>
            <td><%= packet.confidence %></td>
            <td>
              <%= packet.reason %>
              <% if packet.transcript.present? %>
                <details class="agent-reasoning">
                  <summary>Cross-channel thread</summary>
                  <pre class="mk-source" style="white-space:pre-wrap;"><%= packet.transcript %></pre>
                </details>
              <% end %>
            </td>
            <td><%= packet.recommended_action %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No pending handoffs.</p>
  <% end %>
</section>

<section id="high-intent-buyers" class="mk-card-section">
  <h2>High-intent buyers <span class="mk-badge mk-badge--good"><%= @high_intent_buyers.size %></span></h2>
  <p class="mk-muted" style="font-size:.85em;">Triaged from neutral signals on each visitor's profile (financing pre-approval + near-term move) — never a protected class.</p>
  <% if @high_intent_buyers.any? %>
    <table class="mk-table">
      <thead>
        <tr><th>Buyer</th><th>Status</th><th>Signals</th></tr>
      </thead>
      <tbody>
        <% @high_intent_buyers.each do |v| %>
          <tr class="high-intent-buyer">
            <td><%= v.name %> &lt;<%= v.email %>&gt;</td>
            <td><span class="mk-badge mk-badge--good">high-intent</span></td>
            <td class="mk-muted"><%= v.engagement_signals.map { |k, val| "#{k.tr('_', ' ')}: #{val}" }.join(" · ") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No high-intent buyers yet.</p>
  <% end %>
</section>

<section id="offers-awaiting-sign" class="mk-card-section">
  <h2>Offers awaiting broker sign <span class="mk-badge mk-badge--good"><%= @offers.size %></span></h2>
  <% if @offers.any? %>
    <table class="mk-table">
      <thead>
        <tr>
          <th>Lead</th>
          <th>Side</th>
          <th>Property</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @offers.each do |offer| %>
          <tr class="offer">
            <td><%= offer.lead.address %></td>
            <td><%= offer.side %></td>
            <td><%= offer.property&.address || "—" %></td>
            <td><%= number_to_currency(offer.amount) if offer.amount %></td>
            <td><span class="mk-badge mk-badge--warn"><%= offer.status %></span></td>
            <td><%= button_to "Sign & deliver contract", sign_broker_offer_path(offer), method: :post, class: "mk-btn" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No offers awaiting signature.</p>
  <% end %>
</section>

<section id="flagged-photos" class="mk-card-section">
  <h2>Photo red-flags for review <span class="mk-badge mk-badge--warn"><%= @flagged_photos.sum { |pa| pa.review_findings.size } %></span></h2>
  <p class="mk-muted" style="font-size:.85em;">Visible defects the vision model surfaced. These are <strong>never</strong> asserted to buyers — a licensed broker reviews them.</p>
  <% if @flagged_photos.any? %>
    <table class="mk-table">
      <thead>
        <tr><th>Property</th><th>Finding</th><th>Confidence</th></tr>
      </thead>
      <tbody>
        <% @flagged_photos.each do |pa| %>
          <% pa.review_findings.each do |f| %>
            <tr class="flagged-photo">
              <td><%= pa.property&.address || pa.address %></td>
              <td><%= f["label"].to_s.tr("_", " ") %></td>
              <td><%= (f["confidence"].to_f * 100).round %>%</td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No photo red-flags flagged.</p>
  <% end %>
</section>

<section id="pending-showings" class="mk-card-section">
  <h2>Pending showings <span class="mk-badge mk-badge--warn"><%= @pending_showings.size %></span></h2>
  <% if @pending_showings.any? %>
    <table class="mk-table">
      <thead>
        <tr>
          <th>Property</th>
          <th>Type</th>
          <th>Requested time</th>
          <th>Requester</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @pending_showings.each do |appt| %>
          <tr class="pending-showing">
            <td><%= appt.property.address %></td>
            <td><%= appt.kind %></td>
            <td><%= appt.starts_at.strftime("%a %b %-d, %-l:%M %p") %></td>
            <td class="mk-muted"><%= appt.requester_name.presence || appt.requester_email.presence || "—" %></td>
            <td>
              <%= button_to "Confirm", confirm_broker_appointment_path(appt), method: :post, class: "mk-btn" %>
              <%= button_to "Decline", decline_broker_appointment_path(appt), method: :post, class: "mk-btn mk-btn--ghost" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No showings awaiting confirmation.</p>
  <% end %>
</section>
