<% content_for :title, "Broker console — Atlas" %>

<div class="mk-results-head">
  <h1>Review dashboard</h1>
  <span class="mk-count">The human-in-the-loop: nothing is signed until a licensed broker approves it.</span>
</div>

<section id="time-to-offer" class="mk-card-section">
  <h2>Time to offer</h2>
  <table class="mk-table">
    <thead>
      <tr>
        <th>Side</th>
        <th>Offers recorded</th>
        <th>Average time to offer</th>
      </tr>
    </thead>
    <tbody>
      <% @time_to_offer.each do |side, stats| %>
        <tr class="time-to-offer" data-side="<%= side %>">
          <td><%= side.capitalize %></td>
          <td class="count"><%= stats[:count] %></td>
          <td class="average">
            <%= stats[:average_seconds] ? distance_of_time_in_words(stats[:average_seconds]) : "—" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section id="handoff-queue" class="mk-card-section">
  <h2>Handoff queue <span class="mk-badge mk-badge--warn"><%= @handoffs.size %></span></h2>
  <% if @handoffs.any? %>
    <table class="mk-table">
      <thead>
        <tr>
          <th>Lead</th>
          <th>Trigger</th>
          <th>Confidence</th>
          <th>Reason</th>
          <th>Recommended action</th>
        </tr>
      </thead>
      <tbody>
        <% @handoffs.each do |packet| %>
          <tr class="handoff">
            <td><%= packet.lead.address %> (<%= packet.lead.side %>)</td>
            <td><%= packet.trigger %></td>
            <td><%= packet.confidence %></td>
            <td>
              <%= packet.reason %>
              <% if packet.transcript.present? %>
                <details class="agent-reasoning">
                  <summary>Cross-channel thread</summary>
                  <pre class="mk-source" style="white-space:pre-wrap;"><%= packet.transcript %></pre>
                </details>
              <% end %>
            </td>
            <td><%= packet.recommended_action %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No pending handoffs.</p>
  <% end %>
</section>

<section id="high-intent-buyers" class="mk-card-section">
  <h2>High-intent buyers <span class="mk-badge mk-badge--good"><%= @high_intent_buyers.size %></span></h2>
  <p class="mk-muted" style="font-size:.85em;">Triaged from neutral signals on each visitor's profile (financing pre-approval + near-term move) — never a protected class.</p>
  <% if @high_intent_buyers.any? %>
    <table class="mk-table">
      <thead>
        <tr><th>Buyer</th><th>Status</th><th>Signals</th></tr>
      </thead>
      <tbody>
        <% @high_intent_buyers.each do |v| %>
          <tr class="high-intent-buyer">
            <td><%= v.name %> &lt;<%= v.email %>&gt;</td>
            <td><span class="mk-badge mk-badge--good">high-intent</span></td>
            <td class="mk-muted"><%= v.engagement_signals.map { |k, val| "#{k.tr('_', ' ')}: #{val}" }.join(" · ") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No high-intent buyers yet.</p>
  <% end %>
</section>

<section id="offers-awaiting-sign" class="mk-card-section">
  <h2>Offers awaiting broker sign <span class="mk-badge mk-badge--good"><%= @offers.size %></span></h2>
  <% if @offers.any? %>
    <table class="mk-table">
      <thead>
        <tr>
          <th>Lead</th>
          <th>Side</th>
          <th>Property</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @offers.each do |offer| %>
          <tr class="offer">
            <td><%= offer.lead.address %></td>
            <td><%= offer.side %></td>
            <td><%= offer.property&.address || "—" %></td>
            <td><%= number_to_currency(offer.amount) if offer.amount %></td>
            <td><span class="mk-badge mk-badge--warn"><%= offer.status %></span></td>
            <td><%= button_to "Sign & deliver contract", sign_broker_offer_path(offer), method: :post, class: "mk-btn" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty mk-muted">No offers awaiting signature.</p>
  <% end %>
</section>
