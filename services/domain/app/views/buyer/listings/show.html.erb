<% content_for :title, "#{@listing.address} — Atlas" %>
<% content_for :agent_context do %>
  <div id="agent-context" data-address="<%= @listing.address %>" data-listing-id="<%= @listing.id %>" hidden></div>
<% end %>

<p><%= link_to "← Back to homes", buyer_listings_path, class: "mk-nav-link" %></p>

<div class="mk-detail-gallery">
  <img src="<%= @listing.photo_urls&.first %>" alt="<%= @listing.address %>">
  <div class="stack">
    <% Array(@listing.photo_urls)[1..]&.each do |url| %>
      <img src="<%= url %>" alt="<%= @listing.address %>">
    <% end %>
  </div>
</div>

<div class="mk-detail-head">
  <div>
    <div class="mk-price"><%= number_to_currency(@listing.list_price, precision: 0) %></div>
    <div class="mk-addr"><%= @listing.address %></div>
  </div>
  <span class="mk-region"><%= @listing.region %></span>
</div>

<div class="mk-detail-facts">
  <span><b><%= @listing.beds %></b> beds</span>
  <span><b><%= @listing.baths&.to_f %></b> baths</span>
  <span><b><%= number_with_delimiter(@listing.sqft) %></b> sqft</span>
  <span>Built <b><%= @listing.year_built %></b></span>
</div>

<p><%= link_to "Make an offer →", new_buyer_listing_offer_path(@listing), class: "mk-btn" %></p>

<% if @showings %>
  <div class="mk-card-section" id="schedule-showing">
    <h2>📅 Schedule a showing</h2>
    <% if @showings.any? %>
      <div class="mk-slot-grid">
        <% @showings.slots.first(6).each do |slot| %>
          <%= button_to slot.starts_at.strftime("%a %b %-d, %-l:%M %p"),
                buyer_listing_showings_path(@listing),
                params: { starts_at: slot.starts_at.iso8601, kind: "tour" },
                class: "mk-btn mk-btn--ghost" %>
        <% end %>
      </div>
      <p class="mk-muted">Pick a time to request a tour — a licensed broker confirms it. Booked slots are already filtered out.</p>
    <% else %>
      <p class="mk-muted"><%= @showings.reason %></p>
    <% end %>
  </div>
<% end %>

<% if @reconciliation&.market_ppsf %>
  <div class="mk-card-section" id="neighborhood-pulse">
    <h2>📊 Neighborhood pulse</h2>
    <div class="mk-detail-facts">
      <span>Market <b>$<%= @reconciliation.market_ppsf %></b>/sqft</span>
      <% if @reconciliation.subject_ppsf %><span>This home <b>$<%= @reconciliation.subject_ppsf %></b>/sqft</span><% end %>
      <% if @reconciliation.market_median %><span>ZIP median <b><%= number_to_currency(@reconciliation.market_median, precision: 0) %></b></span><% end %>
    </div>
    <% if @reconciliation.signal %>
      <% sig_badge = @reconciliation.signal == :cool ? "mk-badge--good" : (@reconciliation.signal == :hot ? "mk-badge--warn" : "mk-badge--good") %>
      <p>
        <span class="mk-badge <%= sig_badge %>"><%= @reconciliation.signal == :hot ? "Seller's market" : (@reconciliation.signal == :cool ? "Room to negotiate" : "Balanced market") %></span>
        <span class="mk-muted"><%= @reconciliation.signal_reason %></span>
      </p>
    <% end %>
    <% market_src = @reconciliation.sources.find { |s| s.source_id.to_s.start_with?("market:") } %>
    <% if market_src %>
      <p class="mk-source">Source: <%= market_src.source_id %><% if market_src.as_of.present? %> · as of <%= market_src.as_of.to_date.strftime("%b %-d, %Y") rescue market_src.as_of %><% end %>. Sample market data for this demo.</p>
    <% end %>
  </div>
<% end %>

<div class="mk-card-section">
  <h2>About this home</h2>
  <p class="mk-muted"><%= @listing.description %></p>
</div>

<% if @comps.any? %>
  <div class="mk-card-section">
    <h2>Recent nearby sales</h2>
    <% @comps.each do |comp| %>
      <div class="mk-comp-row">
        <span><%= comp.address %> · <%= comp.region %></span>
        <span><b><%= number_to_currency(comp.sale_price, precision: 0) %></b> · <%= comp.sale_date.strftime("%b %Y") %></span>
      </div>
    <% end %>
    <p class="mk-source">Source: <%= @comps.first.source_name %></p>
  </div>
<% end %>

<p class="mk-source">
  Listing data: <%= @listing.source_name %> ·
  sample captured <%= @listing.captured_at&.strftime("%b %-d, %Y") %>.
  Photos are sample imagery.
</p>
