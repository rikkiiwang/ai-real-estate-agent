<%# Persistent agent sidebar. data-turbo-permanent keeps the conversation across
    navigation; the Stimulus controller syncs the current page context (a listing
    address) into the hidden fields on every Turbo visit. %>
<div id="agent-sidebar" data-turbo-permanent data-controller="agent-sidebar" class="agent">
  <div class="agent-head">
    <div class="agent-title">▲ Ask Atlas</div>
    <div class="agent-sub">Grounded answers — every number cited. Atlas brings in a licensed broker when it should.</div>
  </div>

  <div id="agent-messages" class="agent-messages" data-agent-sidebar-target="messages">
    <div class="agent-msg agent-msg--bot">
      <div class="agent-bubble">
        Hi — I'm Atlas. Ask me about a neighborhood, a price, or whether a home is a good deal.
        Open a listing and I'll know which home you mean.
      </div>
    </div>
  </div>

  <div class="agent-thinking" data-agent-sidebar-target="thinking" hidden>
    <span class="agent-dot"></span><span class="agent-dot"></span><span class="agent-dot"></span>
  </div>

  <%= form_with url: agent_messages_path, method: :post,
                data: { controller: nil, agent_sidebar_target: "form",
                        action: "turbo:submit-start->agent-sidebar#start turbo:submit-end->agent-sidebar#end" },
                class: "agent-composer" do |f| %>
    <%= hidden_field_tag :address, "", data: { agent_sidebar_target: "address" } %>
    <%= hidden_field_tag :listing_id, "", data: { agent_sidebar_target: "listingId" } %>

    <%# Omnichannel: reach Atlas on any channel — one continuous thread (R6). %>
    <div class="agent-channels">
      <%= select_tag :channel, options_for_select(Channel::CHANNELS.map { |c| [c.upcase, c] }, "chat"),
            data: { agent_sidebar_target: "channel" }, class: "agent-channel-select" %>
      <span class="agent-channels-note">one thread, every channel · simulated transport</span>
    </div>

    <div class="agent-input-row">
      <%= text_area_tag :query, nil, rows: 2, placeholder: "Type — or tap 🎙 to speak…",
            data: { agent_sidebar_target: "input", action: "keydown.enter->agent-sidebar#enter" } %>
      <button type="button" class="mk-btn mk-btn--ghost agent-mic" title="Speak to Atlas (voice input)"
              data-agent-sidebar-target="mic" data-action="agent-sidebar#dictate" hidden>🎙</button>
    </div>

    <%# Neutral buyer signals — feed intent triaging on your profile (R5). %>
    <% if signed_in? %>
      <div class="agent-signals-toggles">
        <label><%= check_box_tag :preapproval, "1", false %> Pre-approved</label>
        <label><%= check_box_tag :move_soon, "1", false %> Move ≤30 days</label>
      </div>
    <% end %>

    <%= f.submit "Ask", class: "mk-btn agent-send" %>
  <% end %>
</div>
